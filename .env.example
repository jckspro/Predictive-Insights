# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NEO4J CONNECTION CONFIGURATION
VITE_NEO4J_URI=bolt://MY_NEO4J_HOST:7687
VITE_NEO4J_USER=MY_NEO4J_USER
VITE_NEO4J_PASSWORD=MY_NEO4J_PASSWORD
VITE_NEO4J_DATABASE=MY_NEO4J_DATABASE
